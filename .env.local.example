# BURNBOARD Environment Variables
# Copy to .env.local for local development or set in Vercel Project Settings

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# New Supabase publishable key format (sb_publishable_...) — accepted as fallback
# by all clients. Set at least one of ANON_KEY / PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://burnboard.app

# Optional (Vercel Analytics & Speed Insights)
# Injected automatically by Vercel

# Optional Stripe / Coffee Webhook Secrets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
