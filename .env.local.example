# BURNBOARD Environment Variables
# Copy to .env.local for local development or set in Vercel Project Settings

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# New Supabase publishable key format (sb_publishable_...) — accepted as fallback
# by all clients. Set at least one of ANON_KEY / PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://burnboard.app

# Optional (Vercel Analytics & Speed Insights)
# Injected automatically by Vercel

# Optional Stripe / Coffee Webhook Secrets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server-only secrets (NEVER prefix with NEXT_PUBLIC_ — never shipped to
# the browser bundle). Required in production; fail-closed when missing.
# ADMIN_PASSWORD enables the admin gate (no default — unset means 503).
#ADMIN_PASSWORD=
# CRON_SECRET authorizes scheduled jobs + ops dashboards (bearer).
#CRON_SECRET=
# Service-role key for server-side privileged writes only.
#SUPABASE_SERVICE_ROLE_KEY=
# Internal webhook signing pepper.
#PLATFORM_WEBHOOK_PEPPER=
# Optional alert delivery for the observability pipeline.
#OBS_ALERT_WEBHOOK_URL=
# Optional salt for abuse-grouping IP hashes (not an auth secret).
#RATE_LIMIT_SALT=
# Internal app origin used for server-to-server callbacks.
#NEXT_PUBLIC_APP_URL=http://localhost:3000
